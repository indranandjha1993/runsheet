{
  "name": "runsheet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check --ignore-unknown \"packages/**\" \"services/**\" \"contracts/**\" \"infra/**\" \"*.{json,js,ts,md,yaml}\"",
    "format": "prettier --write --ignore-unknown \"packages/**\" \"services/**\" \"contracts/**\" \"infra/**\" \"*.{json,js,ts,md,yaml}\"",
    "typecheck": "tsc -b && tsc -p tsconfig.eslint.json",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
