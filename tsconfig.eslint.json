{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/*/src/**/*",
    "contracts/src/**/*",
    "services/*/src/**/*",
    "api/src/**/*",
    "spec/src/**/*",
    "apps/*/src/**/*",
    "apps/web/src/**/*.tsx"
  ]
}
