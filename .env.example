# Runsheet configuration.
#
# Copy this file to .env and adjust. Every value here works against the local stack that
# `make up` starts, so a fresh clone runs without editing anything.
#
#   cp .env.example .env && make up && make migrate && make dev
#
# Nothing in the code assumes a hosted address. Every URL below is yours.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# debug | info | warn | error. Use debug locally, info in production.
LOG_LEVEL=debug

# Where the services can be reached from outside. Used to build tracking links and
# webhook callbacks. Set this to your own domain when you deploy.
PUBLIC_BASE_URL=http://localhost:14000

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

# One database per service. The local stack creates all of them.
DATABASE_URL_IDENTITY=postgres://runsheet:runsheet@localhost:15432/identity_tenancy
DATABASE_URL_NETWORK=postgres://runsheet:runsheet@localhost:15432/network
DATABASE_URL_ADDRESS=postgres://runsheet:runsheet@localhost:15432/address
DATABASE_URL_ORDERS=postgres://runsheet:runsheet@localhost:15432/orders_consignments
DATABASE_URL_EXECUTION=postgres://runsheet:runsheet@localhost:15432/execution
DATABASE_URL_PLANNING=postgres://runsheet:runsheet@localhost:15432/planning
DATABASE_URL_PROMISE=postgres://runsheet:runsheet@localhost:15432/promise
DATABASE_URL_EXCEPTIONS=postgres://runsheet:runsheet@localhost:15432/exceptions

REDIS_URL=redis://localhost:16379

# Comma-separated broker addresses.
BROKER_BROKERS=localhost:19092

# Analytics store. Reads never touch a service database.
CLICKHOUSE_URL=http://localhost:18123
CLICKHOUSE_USER=runsheet
CLICKHOUSE_PASSWORD=runsheet

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------

PORT_GATEWAY=14000
PORT_WEB=14100
PORT_IDENTITY=14200
PORT_NETWORK=14210
PORT_ADDRESS=14215
PORT_ORDERS=14220
PORT_EXECUTION=14230
PORT_PLANNING=14240
PORT_PROMISE=14250
PORT_EXCEPTIONS=14260

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Signs tracking links and webhook payloads. Generate your own before deploying:
#   openssl rand -hex 32
# Never reuse the value below outside local development.
SIGNING_SECRET=development-only-do-not-use-in-production

# How long a tracking link stays valid after a consignment reaches a terminal state.
TRACKING_LINK_TTL_HOURS=168

# ---------------------------------------------------------------------------
# Outside services, all optional locally
# ---------------------------------------------------------------------------

# Messaging. Leave blank to log messages instead of sending them.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# Geocoding. Leave blank to use the built-in stub, which is enough to run the demo data.
GEOCODER_PROVIDER=
GEOCODER_API_KEY=

# Object storage for delivery photographs and signatures. Leave blank to use local disk.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
